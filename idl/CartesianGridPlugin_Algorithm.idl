#ifndef _CartesianGridPlugin_Algorithm_IDL_
#define _CartesianGridPlugin_Algorithm_IDL_

#include "SALOME_Exception.idl"
#include "SMESH_Hypothesis.idl"
#include "SMESH_Mesh.idl"

/*!
 * CartesianGridPlugin: Cartesian staircase meshing
 */
module CartesianGridPlugin
{
  typedef sequence<double> DoubleArray;
  typedef sequence<string> StringArray;
  typedef sequence<long> LongArray;

  //! zone of the Cartesian MED export: group name, and for the geometry source the sub-shape
  //! ids of its solids in the main shape
  struct ExportZone
  {
    string    name;
    LongArray ids;
  };
  typedef sequence<ExportZone> ExportZones;

  /*!
   * Cartesian Grid 3D algorithm: one hexahedron per grid cell owned by a solid
   */
  interface CartesianGridPlugin_CartesianGrid_3D : SMESH::SMESH_3D_Algo
  {
    //! Writes the grid of the mesh hypothesis to a MED Cartesian file, one group per zone;
    //! fromMesh false: zones of the owner solids, no element created; true: zones of the
    //! hexahedra of the mesh volume groups named as the zones. Returns the report, one message
    //! per line: KEY<tab>arg<tab>... (text made by CartesianGridPluginBuilder.ExportCartesianMED).
    string ExportCartesianMED(in SMESH::SMESH_Mesh mesh, in string file, in boolean fromMesh,
                              in ExportZones zones) raises (SALOME::SALOME_Exception);
    //! progress of the running export, 0..1
    double GetExportProgress();
    //! stops the running export
    void   CancelExport();
    //! sub-shape ids of the solids of the mesh main shape, in the order the export and the
    //! classifier use (TopExp::MapShapes); for one zone per solid
    LongArray GetSolidIds(in SMESH::SMESH_Mesh mesh) raises (SALOME::SALOME_Exception);
  };

  /*!
   * Cartesian grid hypothesis; axis: 0=X, 1=Y, 2=Z
   */
  interface CartesianGridPlugin_Hypothesis : SMESH::SMESH_Hypothesis
  {
    //! number of cells along axis (mode NbCells)
    void   SetNbCells(in short axis, in long nb) raises (SALOME::SALOME_Exception);
    //! wished step along axis (mode Step), adjusted to cover the extent exactly
    void   SetStep(in short axis, in double step) raises (SALOME::SALOME_Exception);
    //! 0 = NbCells, 1 = Step, 2 = Coordinates, 3 = Spacing
    short  GetMode(in short axis) raises (SALOME::SALOME_Exception);
    long   GetNbCells(in short axis) raises (SALOME::SALOME_Exception);
    double GetStep(in short axis) raises (SALOME::SALOME_Exception);
    //! absolute node coordinates (mode Coordinates): >= 2 distinct values, sorted on input
    void SetCoordinates(in short axis, in DoubleArray coords) raises (SALOME::SALOME_Exception);
    DoubleArray GetCoordinates(in short axis) raises (SALOME::SALOME_Exception);
    //! spacing functions f(t) and internal points in ]0,1[, one less than functions, splitting
    //! the bounding box into ranges; t runs from 0 to 1 within each range (mode Spacing, as
    //! Body Fitting SetGridSpacing)
    void SetSpacing(in short axis, in StringArray functions,
                    in DoubleArray internalPoints) raises (SALOME::SALOME_Exception);
    void GetSpacing(in short axis, out StringArray functions,
                    out DoubleArray internalPoints) raises (SALOME::SALOME_Exception);

    //! keep cells outside all solids (bound to the main shape) instead of removing them
    void    SetKeepOutsideCells(in boolean keep);
    boolean GetKeepOutsideCells();
  };
};

#endif
