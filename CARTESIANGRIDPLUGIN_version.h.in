#if !defined(__CARTESIANGRIDPLUGIN_VERSION_H__)
#define __CARTESIANGRIDPLUGIN_VERSION_H__

/*!
  Specify version of SALOME CARTESIANGRIDPLUGIN module, as follows

  CARTESIANGRIDPLUGIN_VERSION_MAJOR       : (integer) number identifying major version
  CARTESIANGRIDPLUGIN_VERSION_MINOR       : (integer) number identifying minor version
  CARTESIANGRIDPLUGIN_VERSION_MAINTENANCE : (integer) number identifying maintenance version
  CARTESIANGRIDPLUGIN_VERSION_STR         : (string)  complete version number "major.minor.maintenance"
  CARTESIANGRIDPLUGIN_VERSION             : (hex)     complete version number (major << 16) + (minor << 8) + maintenance
  CARTESIANGRIDPLUGIN_DEVELOPMENT         : (integer) indicates development version when set to 1
*/

#define CARTESIANGRIDPLUGIN_VERSION_MAJOR       @SALOMECARTESIANGRIDPLUGIN_MAJOR_VERSION@
#define CARTESIANGRIDPLUGIN_VERSION_MINOR       @SALOMECARTESIANGRIDPLUGIN_MINOR_VERSION@
#define CARTESIANGRIDPLUGIN_VERSION_MAINTENANCE @SALOMECARTESIANGRIDPLUGIN_PATCH_VERSION@
#define CARTESIANGRIDPLUGIN_VERSION_STR         "@SALOMECARTESIANGRIDPLUGIN_VERSION@"
#define CARTESIANGRIDPLUGIN_VERSION             @SALOMECARTESIANGRIDPLUGIN_XVERSION@
#define CARTESIANGRIDPLUGIN_DEVELOPMENT         @SALOMECARTESIANGRIDPLUGIN_VERSION_DEV@

#endif // __CARTESIANGRIDPLUGIN_VERSION_H__
