INCLUDE(tests.set)
INCLUDE(examples.set OPTIONAL)   # examples of the user's guide, installed with SALOME_BUILD_DOC=ON

SET(COMPONENT_NAME CARTESIANGRIDPLUGIN)
SET(SALOME_TEST_DRIVER "$ENV{KERNEL_ROOT_DIR}/bin/salome/appliskel/python_test_driver.py")
SET(TIMEOUT 300)

FOREACH(tfile ${TEST_NAMES} ${EXAMPLE_NAMES})
  SET(TEST_NAME ${COMPONENT_NAME}_${tfile})
  ADD_TEST(${TEST_NAME} python ${SALOME_TEST_DRIVER} ${TIMEOUT} ${tfile}.py)
  SET_TESTS_PROPERTIES(${TEST_NAME} PROPERTIES LABELS "${COMPONENT_NAME}")
ENDFOREACH()
