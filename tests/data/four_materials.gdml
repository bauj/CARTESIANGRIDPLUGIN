<?xml version="1.0" encoding="UTF-8"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">

  <define>
    <position name="GDML_PhysicalVolume_1_pos" x="0" y="0" z="0" unit="mm"/>
    <rotation name="GDML_PhysicalVolume_1_rot" x="0" y="0" z="0" unit="deg"/>
    <position name="GDML_PhysicalVolume_2_pos" x="-50" y="0" z="0" unit="mm"/>
    <rotation name="GDML_PhysicalVolume_2_rot" x="0" y="0" z="0" unit="deg"/>
    <position name="GDML_PhysicalVolume_3_pos" x="50" y="-40" z="0" unit="mm"/>
    <rotation name="GDML_PhysicalVolume_3_rot" x="0" y="0" z="0" unit="deg"/>
    <position name="GDML_PhysicalVolume_4_pos" x="50" y="40" z="0" unit="mm"/>
    <rotation name="GDML_PhysicalVolume_4_rot" x="0" y="0" z="0" unit="deg"/>
  </define>

  <materials>
    <material name="LEAD">
      <D unit="g/cm3" value="1.0"/>
    </material>
    <material name="IRON">
      <D unit="g/cm3" value="1.0"/>
    </material>
    <material name="WOOD">
      <D unit="g/cm3" value="1.0"/>
    </material>
    <material name="AIR">
      <D unit="g/cm3" value="1.0"/>
    </material>
  </materials>

  <solids>
    <box name="GDML_Box_1" x="200" y="200" z="200" lunit="mm"/>
    <box name="GDML_Box_2" x="80" y="80" z="80" lunit="mm"/>
    <box name="GDML_Box_3" x="20" y="20" z="20" lunit="mm"/>
    <box name="GDML_Box_4" x="40" y="40" z="40" lunit="mm"/>
  </solids>

  <structure>
    <volume name="GDML_LogicalVolume_1">
      <materialref ref="LEAD"/>
      <solidref ref="GDML_Box_3"/>
    </volume>
    <volume name="GDML_LogicalVolume_2">
      <materialref ref="IRON"/>
      <solidref ref="GDML_Box_2"/>
      <physvol name="GDML_PhysicalVolume_1">
        <volumeref ref="GDML_LogicalVolume_1"/>
        <positionref ref="GDML_PhysicalVolume_1_pos"/>
        <rotationref ref="GDML_PhysicalVolume_1_rot"/>
      </physvol>
    </volume>
    <volume name="GDML_LogicalVolume_3">
      <materialref ref="WOOD"/>
      <solidref ref="GDML_Box_4"/>
    </volume>
    <volume name="GDML_WorldVolume_1">
      <materialref ref="AIR"/>
      <solidref ref="GDML_Box_1"/>
      <physvol name="GDML_PhysicalVolume_2">
        <volumeref ref="GDML_LogicalVolume_2"/>
        <positionref ref="GDML_PhysicalVolume_2_pos"/>
        <rotationref ref="GDML_PhysicalVolume_2_rot"/>
      </physvol>
      <physvol name="GDML_PhysicalVolume_3">
        <volumeref ref="GDML_LogicalVolume_3"/>
        <positionref ref="GDML_PhysicalVolume_3_pos"/>
        <rotationref ref="GDML_PhysicalVolume_3_rot"/>
      </physvol>
      <physvol name="GDML_PhysicalVolume_4">
        <volumeref ref="GDML_LogicalVolume_3"/>
        <positionref ref="GDML_PhysicalVolume_4_pos"/>
        <rotationref ref="GDML_PhysicalVolume_4_rot"/>
      </physvol>
    </volume>
  </structure>

  <setup name="Default" version="1.0">
    <world ref="GDML_WorldVolume_1"/>
  </setup>

</gdml>
